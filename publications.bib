	month = jun,
	year = {2021},
	pages = {1732--1743},
	file = {Full Text PDF:/Users/ianporada/Zotero/storage/K3J9H9WL/Porada et al. - 2021 - Modeling Event Plausibility with Consistent Concep.pdf:application/pdf},
}
